EXPO_PUBLIC_POLLING_INTERVAL_MS=1000
EXPO_PUBLIC_DATA_SOURCE=mock
EXPO_PUBLIC_MOCK_LATENCY_MS=350
# API mode requires your backend origin (including any deployment prefix).
# Do not use localhost for a physical phone unless it resolves to your backend.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Connected build identity. These are public Firebase app identifiers.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Development builds only. See the backend management guide.
EXPO_PUBLIC_FIREBASE_EMULATOR_ORIGIN=
