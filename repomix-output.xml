import React from 'react';
import { View, StyleSheet, Pressable } from 'react-native';
import { AppText } from '../atoms/AppText';
import { AppButton } from '../atoms/AppButton';
import { StatusBadge } from '../atoms/StatusBadge';
import { useThemeStore } from '@/store/useThemeStore';
import { PALETTE } from '@/config/theme';
import { Grant } from '@/types/grant';

export interface GrantCardProps {
  grant: Grant;
  onSelect: () => void;
  onApply: () => void;
}

export function GrantCard({ grant, onSelect, onApply }: GrantCardProps) {
  const { mode } = useThemeStore();
  const theme = PALETTE[mode];

  const getMatchVariant = (pct: number) => {
    if (pct >= 80) return 'verified';
    if (pct >= 40) return 'pending';
    return 'failure';
  };

  return (
    <Pressable
      onPress={onSelect}
      style={({ pressed }) => [
        styles.card,
        {
          backgroundColor: theme.surface,
          borderColor: pressed ? theme.primary : theme.border,
        },
      ]}
    >
      <View style={styles.header}>
        <StatusBadge label={grant.funder} variant="neutral" />
        <StatusBadge label={`${grant.matchPct}% match`} variant={getMatchVariant(grant.matchPct)} />
      </View>

      <AppText variant="h3" style={styles.title} numberOfLines={2}>
        {grant.title}
      </AppText>

      <View style={styles.metricsGrid}>
        <View style={styles.metricColumn}>
          <AppText variant="caption" color="muted">Funding</AppText>
          <AppText variant="metric-sm" color="main">{grant.amount}</AppText>
        </View>
        <View style={styles.metricColumn}>
          <AppText variant="caption" color="muted">Deadline</AppText>
          <AppText variant="metric-sm" color="main">{grant.deadline}</AppText>
        </View>
      </View>

      <View style={[styles.footer, { borderTopColor: theme.border }]}>
        <AppText variant="caption" color="muted" style={styles.region}>
          {grant.region}
        </AppText>
        <View style={styles.actions}>
          <AppButton label="Details" variant="ghost" size="sm" onPress={onSelect} />
          <AppButton label="Apply" variant="primary" size="sm" onPress={onApply} />
        </View>
      </View>
    </Pressable>
  );
}

