import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { apiClient } from '../client';
import { ENDPOINTS } from '../endpoint';
import { AuditScanResponse } from '@/types/api';
import { ENV } from '@/config/env';

export function useAuditStatus(grantId: string, isScanning: boolean) {
  return useQuery<AuditScanResponse>({
    queryKey: ['audit-status', grantId],
    queryFn: async () => {
      const response = await apiClient.get(ENDPOINTS.PROPOSAL_AUDIT(grantId));
      return response.data;
    },
    enabled: Boolean(grantId),
    refetchInterval: isScanning ? ENV.POLLING_INTERVAL_MS : false,
  });
}

export function useTriggerAuditScan(grantId: string) {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: async () => {
      const response = await apiClient.post(ENDPOINTS.PROPOSAL_AUDIT(grantId), {
        triggerMode: 'full_scan',
      });
      return response.data;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['audit-status', grantId] });
    },
  });
}
</file>

<file path="src/api/hooks/useGrantDetail.ts">
import { useQuery } from '@tanstack/react-query';
import { apiClient } from '../client';
import { ENDPOINTS } from '../endpoint';
import { Grant } from '@/types/grant';
import { mockGrants } from '@/mock/grants';

export function useGrantDetail(grantId: string) {
  return useQuery<Grant>({
    queryKey: ['grant', grantId],
    queryFn: async () => {
      try {
        const response = await apiClient.get(ENDPOINTS.GRANT_DETAIL(grantId));
        return response.data;
      } catch (_err) {
        return mockGrants.find((g) => g.id === grantId) ?? mockGrants[0];
      }
    },
    enabled: Boolean(grantId),
  });
}
</file>

<file path="src/api/hooks/useGrants.ts">
import { useQuery } from '@tanstack/react-query';
import { apiClient } from '../client';
import { ENDPOINTS } from '../endpoint';
import { Grant } from '@/types/grant';
import { mockGrants } from '@/mock/grants';

export function useGrants(query?: string) {
  return useQuery<Grant[]>({
    queryKey: ['grants', query],
    queryFn: async () => {
      try {
        const response = await apiClient.get(ENDPOINTS.GRANTS, { params: { q: query } });
        return response.data;
      } catch (_err) {
        // Hermetic fallback for disconnected demo runs
        if (!query) return mockGrants;
        return mockGrants.filter(
          (g) =>
            g.title.toLowerCase().includes(query.toLowerCase()) ||
            g.funder.toLowerCase().includes(query.toLowerCase())
        );
      }
    },
    staleTime: 1000 * 60 * 5,
  });
}
</file>

<file path="src/api/hooks/useProposalDraft.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { apiClient } from '../client';
import { ENDPOINTS } from '../endpoint';
import { ProposalDraft } from '@/types/api';

export function useProposalDraft(grantId: string) {
  return useQuery<ProposalDraft>({
    queryKey: ['proposal-draft', grantId],
    queryFn: async () => {
      const response = await apiClient.get(ENDPOINTS.PROPOSAL_DRAFT(grantId));
      return response.data;
    },
    enabled: Boolean(grantId),
  });
}

export function useMutateProposalSections(grantId: string) {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: async (payload: { action: 'remove' | 'add' | 'restore'; sectionName: string }) => {
      const response = await apiClient.patch(ENDPOINTS.PROPOSAL_SECTIONS(grantId), payload);
      return response.data;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['proposal-draft', grantId] });
      queryClient.invalidateQueries({ queryKey: ['audit-status', grantId] });
    },
  });
}
</file>

