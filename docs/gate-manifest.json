    {
      "code": "EXPORT-REGRESSION",
      "input": "prevPack",
      "reason": "Baseline packs are regenerated, renamed and untracked every cycle (RUL-V3-01). The check runs at closure with an explicitly named previous -green pack via --prev-pack or config.grantum.prevPack. A declared-but-missing baseline is SKIPPED and fails strict; an undeclared baseline prints this INFO line every run, never silent."
    }
  ],
  "excludedExtensions": []
}
