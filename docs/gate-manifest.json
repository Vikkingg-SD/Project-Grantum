{
  "version": 1,
  "requiredEveryGate": [
    "ROOT-STRAY",
    "REPOMIX-TRACKED",
    "EMPTY-FILE",
    "MISSING-FILE",
    "EMPTY-TARGET",
    "NO-DEFAULT",
    "MISSING-EXPORT",
    "BANNED-DEP",
    "MOCK-LEAK",
