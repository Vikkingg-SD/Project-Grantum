# Application Environment
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# Backend Flask REST Service
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api/v1
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Telemetry & Feature Toggles
EXPO_PUBLIC_ENABLE_ANALYTICS=0
EXPO_PUBLIC_POLLING_INTERVAL_MS=3000